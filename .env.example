# ===== Database =====
DATABASE_URL="postgresql://narintown:narintown@localhost:5432/narintown?schema=public"

# ===== Redis =====
REDIS_URL="redis://localhost:6379"

# ===== Game Server =====
GAME_SERVER_PORT=3001
# CORS 허용 origin = web 도메인 (운영에선 Vercel URL)
GAME_SERVER_ORIGIN="http://localhost:3000"

# ===== Web (Next.js) =====
# 서버 사이드에서 game-server 호출 (운영에선 Railway URL)
GAME_SERVER_URL="http://localhost:3001"
# 브라우저에서 Socket.IO 연결 (운영에선 Railway URL)
NEXT_PUBLIC_GAME_SERVER_URL="http://localhost:3001"

# ===== Auth =====
SESSION_SECRET="change-me-32-bytes-or-longer-please"
MAGIC_LINK_TTL_MINUTES=15
INVITE_CODE_REQUIRED=true
# 가입 허용 이메일 도메인 (소문자)
ALLOWED_EMAIL_DOMAIN="navercorp.com"

# ===== Mail =====
# 로컬: MailHog 사용 (smtp)
# 운영: resend
MAIL_PROVIDER="smtp"
MAIL_FROM="NarinTown <noreply@narintown.local>"

# SMTP (로컬 MailHog) — MAIL_PROVIDER=smtp 일 때
SMTP_HOST="localhost"
SMTP_PORT=1025
SMTP_USER=""
SMTP_PASS=""

# Resend (운영) — MAIL_PROVIDER=resend 일 때
# RESEND_API_KEY="re_..."
